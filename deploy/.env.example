# Copy to deploy/.env (git-ignored). Never commit real credentials.
NEO4J_ACCEPT_LICENSE_AGREEMENT=eval
UNIONDEB_NEO4J_URI=neo4j://localhost:7687
UNIONDEB_NEO4J_USER=neo4j
UNIONDEB_NEO4J_PASSWORD=change-me-please
UNIONDEB_NEO4J_DATABASE=neo4j
# AuraDB: UNIONDEB_NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# Containers in deploy/compose.yml ignore UNIONDEB_NEO4J_URI above and use neo4j://neo4j:7687.
# The api and worker services (docker compose --profile app up -d) need these three. Generate them:
#   UNIONDEB_FIELD_KEY       docker compose run --rm uniondeb store keygen   (encrypts raw rows and case packs)
#   UNIONDEB_PSEUDONYM_KEY   openssl rand -hex 32                            (stable pseudonyms in alerts)
#   UNIONDEB_AUTH_SECRET     openssl rand -hex 32                            (development sign-in only)
# Production uses OIDC instead of UNIONDEB_AUTH_SECRET: UNIONDEB_OIDC_JWKS_URL, _ISSUER, _AUDIENCE.
# Agents that use a model run only when one is named, e.g. UNIONDEB_DIDOLWR_MODEL=ollama:llama3.3
# (also _PORTHOR_, _CRYNHOI_, _HOLWR_). Without it the deterministic pipeline still runs.
# UNIONDEB_FIELD_KEY=
# UNIONDEB_PSEUDONYM_KEY=
# UNIONDEB_AUTH_SECRET=
# Optional: host ports, and (Linux) your own uid/gid so files written to ./data are yours.
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# UNIONDEB_UID=1000
# UNIONDEB_GID=1000
